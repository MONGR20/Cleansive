# Read by the BigWigs packager, which Wago and CurseForge run from a GitHub
# action. It does nothing when you zip by hand.
#
# This file belongs at the repository root, next to the Cleansive/ folder --
# not inside it.

package-as: Cleansive

# Cleansive embeds no libraries, so a "nolib" variant would be byte-identical
# to the normal one. Building it would only confuse the download page.
enable-nolib-creation: no

# Use the changelog the addon ships instead of letting the packager paste a
# commit log into the release notes.
# Les notes de version, PAS l'historique complet. GitHub refuse un corps de
# release au-dela de 125 000 caracteres, et CHANGELOG.md a franchi cette limite
# a la v1.6.13 : CurseForge et Wago avaient bien recu l'archive, seule la
# release GitHub echouait. RELEASE_NOTES.md ne garde que les dernieres versions
# et renvoie au fichier complet, qui reste livre avec l'addon.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

# Everything not listed here is packaged. The addon folder holds no build
# artifacts -- the test harness lives outside it -- so this stays short.
ignore:
  - .pkgmeta
  - .github
  - .gitignore
  # Residu d'une reecriture d'historique. Trois dossiers VIDES, donc invisibles
  # a tout controle qui ne regarde que les fichiers : ils sont partis dans
  # l'archive 1.6 sans que rien ne le signale.
  - .git-rewrite
  - tests
  - "*.bak"
  - .DS_Store

# The addon already ships its own LICENSE.txt, so the packager does not need
# to generate one.
